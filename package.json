{
  "name": "custom-cli-agent",
  "version": "1.0.0",
  "description": "A custom CLI agent tool with file operations, command execution, and natural language understanding",
  "bin": {
    "cli-agent": "./dist/index.js"
  },
  "scripts": {
    "build": "tsc && npm run copy-static",
    "build:gui": "tsc && npm run copy-static && electron-builder",
    "copy-static": "node scripts/copy-static.js",
    "dev": "tsx src/index.ts",
    "dev:gui": "npm run copy-static && concurrently \"tsc --watch\" \"wait-on dist/electron/main.js && electron dist/electron/main.js\"",
    "start": "node dist/index.js",
    "start:gui": "electron dist/electron/main.js",
    "test": "jest",
    "lint": "eslint src --ext .ts",
    "format": "prettier --write src"
  },
  "dependencies": {
    "commander": "^11.1.0",
    "chalk": "^4.1.2",
    "inquirer": "^9.2.12",
    "ora": "^5.4.1",
    "fs-extra": "^11.1.1",
    "glob": "^10.3.10",
    "cross-spawn": "^7.0.3",
    "yaml": "^2.3.4",
    "minimatch": "^9.0.3",
    "chokidar": "^3.5.3",
    "node-fetch": "^2.7.0",
    "@types/node": "^20.8.0",
    "electron": "^27.0.0",
    "@xterm/xterm": "^5.5.0",
    "@xterm/addon-fit": "^0.10.0",
    "@xterm/addon-web-links": "^0.11.0"
  },
  "devDependencies": {
    "typescript": "^5.2.2",
    "tsx": "^4.0.0",
    "@types/fs-extra": "^11.0.4",
    "@types/cross-spawn": "^6.0.6",
    "@types/inquirer": "^9.0.7",
    "@types/node-fetch": "^2.6.9",
    "jest": "^29.7.0",
    "@types/jest": "^29.5.8",
    "ts-jest": "^29.1.1",
    "eslint": "^8.52.0",
    "@typescript-eslint/eslint-plugin": "^6.9.1",
    "@typescript-eslint/parser": "^6.9.1",
    "prettier": "^3.0.3",
    "electron-builder": "^24.6.4",
    "concurrently": "^8.2.2",
    "wait-on": "^7.2.0"
  },
  "keywords": [
    "cli",
    "agent",
    "automation",
    "file-operations",
    "command-execution"
  ],
  "author": "Your Name",
  "license": "MIT",
  "main": "dist/electron/main.js",
  "homepage": ".",
  "build": {
    "appId": "com.example.cli-agent",
    "productName": "CLI Agent",
    "directories": {
      "output": "build"
    },
    "files": [
      "dist/**/*",
      "node_modules/**/*"
    ],
    "win": {
      "target": "nsis"
    },
    "linux": {
      "target": "AppImage"
    },
    "mac": {
      "target": "dmg"
    }
  }
}
